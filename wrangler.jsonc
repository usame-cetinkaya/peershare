{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "peershare",
	"main": "src/index.js",
	"compatibility_date": "2026-10-23",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/ws", "/api/*", "/share"]
	},
	"durable_objects": {
		"bindings": [{ "name": "LOBBY", "class_name": "Lobby" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby"] }],
	"observability": { "enabled": true }
	// Secrets (not in this file): TURN_KEY_ID, TURN_KEY_API_TOKEN
}
